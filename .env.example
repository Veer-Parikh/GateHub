# Copy to .env.local and fill in. Everything is optional — without a backend the app runs in demo mode.

# Express backend (the `backend/` folder). Default: http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Razorpay — only needed for real maintenance payments in live (backend) sessions
RAZORPAY_KEY=
RAZORPAY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY=

# Zoom meeting signature route (/api/zoom) — optional
ZOOM_API_KEY=
ZOOM_API_SECRET=
